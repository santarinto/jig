{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": false,
    "outDir": "dist",
    "rootDir": ".",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["src", "tokens", "types"],
  "exclude": [
    "**/*.test.tsx",
    "**/*.test.ts",
    "**/*.fixture.tsx",
    "src/internal/fixture.ts",
    "src/internal/fixture-validate.ts",
    "src/__smoke__",
    "src/__guards__",
    "vitest.config.ts",
    "vitest.setup.ts"
  ]
}
